# ─── VHSYS ────────────────────────────────────────────────────────────────────
VHSYS_ACCESS_TOKEN=seu_access_token_aqui
VHSYS_SECRET_ACCESS_TOKEN=seu_secret_access_token_aqui

# Credenciais que você vai definir para proteger o webhook (você escolhe)
WEBHOOK_USERNAME=vhsys_webhook
WEBHOOK_PASSWORD=senha_forte_aqui

# ─── TiFlux ───────────────────────────────────────────────────────────────────
TIFLUX_TOKEN=seu_bearer_token_tiflux_aqui

# ─── Servidor ─────────────────────────────────────────────────────────────────
# Porta em que o servidor vai rodar na VPS
PORT=8000
# Host público da sua VPS (usado no setup_webhook.py)
PUBLIC_URL=https://sua-vps.com.br
