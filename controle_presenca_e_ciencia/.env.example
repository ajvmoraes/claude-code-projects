# === Azure AD / EntraID ===
# Obtidos no portal Azure > App registrations > sua aplicação
TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CLIENT_SECRET=your-client-secret-here

# URL de callback (deve ser cadastrada no Azure App Registration)
# Em desenvolvimento: http://localhost:8000/auth/callback
# Em produção: https://seudominio.com/auth/callback
REDIRECT_URI=http://localhost:8000/auth/callback

# === Aplicação ===
# Chave secreta para assinar cookies de sessão (gere com: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=gere-uma-chave-secreta-forte-aqui

# === E-mail (Microsoft Graph) ===
# E-mail do remetente das notificações (deve ter permissão Mail.Send na app registration)
# Pode ser uma conta de serviço ou shared mailbox
FROM_EMAIL=notificacoes@seudominio.com.br
FROM_NAME=Sistema de ATAs

# === Banco de dados ===
DATABASE_URL=sqlite+aiosqlite:///./atas.db
